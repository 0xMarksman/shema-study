PORT=8787
JWT_SECRET=replace-with-a-long-random-string

# Optional — omit both to use a local SQLite file at server/data/bible-planner.db.
# Set both to point at a remote Turso database instead (required for Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Web Push (required for off-app reminder notifications)
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto used in VAPID claims
VAPID_SUBJECT=mailto:admin@example.com
